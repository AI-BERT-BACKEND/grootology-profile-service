# Database
DB_NAME=profile_db
DB_USER=postgres
DB_PASSWORD=your_password
DB_URL=jdbc:postgresql://postgres:5432/profile_db

# Spring
SPRING_PROFILES_ACTIVE=local

# JWT
JWT_SECRET=your_jwt_secret_min_32_chars

# App
APP_BASE_URL=http://localhost:1501

# Mail (Outlook / Microsoft 365 SMTP)
MAIL_HOST=smtp.office365.com
MAIL_PORT=587
MAIL_USERNAME=your_outlook_email@outlook.com
MAIL_PASSWORD=your_outlook_app_password
